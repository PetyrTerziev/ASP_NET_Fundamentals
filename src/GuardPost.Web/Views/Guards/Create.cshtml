@model GuardFormViewModel
@{
    ViewData["Title"] = "Нов охранител";
    ViewData["Subtitle"] = "Добавете охранител към екипа.";
}
<partial name="_PageHeaderPartial" model='"Нов охранител"' />

<div class="gp-card gp-form-card">
    <form asp-action="Create" method="post" novalidate>
        <partial name="_GuardFormFields" model="Model" />
        <div class="gp-form-actions">
            <button type="submit" class="btn btn-gp"><i class="bi bi-check-lg"></i> Добави охранител</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
