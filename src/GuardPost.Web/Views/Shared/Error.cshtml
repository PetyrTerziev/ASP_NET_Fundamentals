@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}
<div class="gp-empty-state">
    <i class="bi bi-bug"></i>
    <h1>Нещо се обърка</h1>
    <p class="text-muted">Възникна неочаквана грешка при обработката на заявката.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Идентификатор на заявката: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-gp" asp-controller="Home" asp-action="Index">Към таблото</a>
</div>
