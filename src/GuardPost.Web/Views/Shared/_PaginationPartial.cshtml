@model PagerViewModel
@if (Model.TotalPages > 1)
{
    <nav aria-label="Страници" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="Model.RouteValuesFor(Model.CurrentPage - 1)">&laquo; Назад</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="Model.RouteValuesFor(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="Model.RouteValuesFor(Model.CurrentPage + 1)">Напред &raquo;</a>
            </li>
        </ul>
    </nav>
}
