@model ShiftFormViewModel
@{
    ViewData["Title"] = "Редактиране на смяна";
}
<partial name="_PageHeaderPartial" model='"Редактиране на смяна"' />

<div class="gp-card gp-form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
        <partial name="_ShiftFormFields" model="Model" />
        <div class="gp-form-actions">
            <button type="submit" class="btn btn-gp"><i class="bi bi-check-lg"></i> Запази промените</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
