@model SiteFormViewModel
@{
    ViewData["Title"] = "Нов обект";
    ViewData["Subtitle"] = "Регистрирайте нов обект за охрана.";
}
<partial name="_PageHeaderPartial" model='"Нов обект"' />

<div class="gp-card gp-form-card">
    <form asp-action="Create" method="post" novalidate>
        <partial name="_SiteFormFields" model="Model" />
        <div class="gp-form-actions">
            <button type="submit" class="btn btn-gp"><i class="bi bi-check-lg"></i> Създай обект</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
