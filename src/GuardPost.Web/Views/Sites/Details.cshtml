@model SiteDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    bool covered = Model.GuardsOnDutyNow >= Model.RequiredGuardsPerShift;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Обекти</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="gp-page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>
            @Model.Name
            @if (!Model.IsActive)
            {
                <span class="badge bg-secondary align-middle fs-6">Неактивен</span>
            }
        </h1>
        <p class="text-muted mb-0"><i class="bi bi-geo-alt"></i> @Model.Address, @Model.City</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark"><i class="bi bi-pencil"></i> Редактирай</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Изтрий</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <section class="gp-card">
            <h2 class="gp-card-title">Договор</h2>
            <dl class="gp-dl mb-0">
                <dt>Възложител</dt>
                <dd>@Model.ClientName</dd>
                <dt>Телефон за връзка</dt>
                <dd><a href="tel:@Model.ContactPhone.Replace(" ", "")">@Model.ContactPhone</a></dd>
                <dt>Охранители на смяна</dt>
                <dd>@Model.RequiredGuardsPerShift</dd>
                <dt>На смяна в момента</dt>
                <dd class="@(covered ? "text-success" : "text-danger") fw-semibold">
                    @Model.GuardsOnDutyNow от @Model.RequiredGuardsPerShift
                    @if (Model.IsActive && !covered)
                    {
                        <span>– недостиг на персонал</span>
                    }
                </dd>
                <dt>Регистриран на</dt>
                <dd>@Model.CreatedOn.ToString(ApplicationConstants.DateFormat)</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <hr />
                <h3 class="h6">Постови инструкции</h3>
                <p class="mb-0 gp-pre">@Model.Description</p>
            }
        </section>
    </div>
    <div class="col-lg-8 d-flex flex-column gap-4">
        <section class="gp-card">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="gp-card-title">Предстоящи смени</h2>
                @if (Model.IsActive)
                {
                    <a class="btn btn-sm btn-gp" asp-controller="Shifts" asp-action="Create" asp-route-siteId="@Model.Id"><i class="bi bi-plus-lg"></i> Добави смяна</a>
                }
            </div>
            <partial name="_ShiftTablePartial" model="Model.UpcomingShifts"
                     view-data='new ViewDataDictionary(ViewData) { ["ShowSite"] = false, ["EmptyText"] = "Няма предстоящи смени за този обект." }' />
        </section>
        <section class="gp-card">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="gp-card-title">Последни инциденти</h2>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Incidents" asp-action="Index" asp-route-siteId="@Model.Id">Всички</a>
                    <a class="btn btn-sm btn-outline-danger" asp-controller="Incidents" asp-action="Create" asp-route-siteId="@Model.Id"><i class="bi bi-megaphone"></i> Сигнал</a>
                </div>
            </div>
            <partial name="_IncidentTablePartial" model="Model.RecentIncidents"
                     view-data='new ViewDataDictionary(ViewData) { ["ShowSite"] = false, ["EmptyText"] = "Няма регистрирани инциденти за този обект." }' />
        </section>
    </div>
</div>
